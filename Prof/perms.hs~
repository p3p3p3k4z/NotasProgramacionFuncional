import Data.List
perms [] = [[]]
perms (a:bs) = [x:ts| x<-(a:bs), ts<-perms (delete x (a:bs))]

subsets [] = [[]]
subsets (a:bs) = (map (a:) ls) ++ ls
	       	 where
			ls = subsets bs
