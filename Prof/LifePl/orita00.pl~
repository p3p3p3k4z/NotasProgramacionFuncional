red(A,B) :- A >> B.

A >> C :- A >=> B, B>>C.
A >> A.

A >=> B :- A => B.
A >=> B :- 
    A=..[G,L], 
    L1 is L, 
    C=..[G,L1],
    C => B.    

A+B >=> C :- A >> A1, B >> B1,
	number(A1), number(B1),
	C is A1+B1.
A+B >=> A1+B :- A >=> A1.
A+B >=> A+B1 :- B >=> B1.

A*B >=> C :- A >> A1, B >> B1,
	number(A1), number(B1),
        C is A1*B1.
    
A*B >=> A1*B :- A >=> A1.
A*B >=> A*B1 :- B >=> B1.
    

fib(0) => 1.
fib(1) => 1.
fib(N) => fib(N-1)+fib(N-2) :- N>1.
    
fact(0) => 1.
fact(N) => N*fact(N-1) :- N>0.
